# Database (PostgreSQL - use Neon, Supabase, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/ns_deer_paradise?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-string-here"
AUTH_URL="http://localhost:3000"

# Email (Resend recommended for transactional emails)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="NS Deer Paradise <noreply@yourdomain.com>"

# Optional: Mapbox or other map providers
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Optional: S3-compatible storage for photos
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

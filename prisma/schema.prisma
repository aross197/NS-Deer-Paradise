// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth.js / NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  huntLogs      HuntLog[]
  trailCams     TrailCamPhoto[]
  waypoints     Waypoint[]
  groups        GroupMember[]
  camJobs       TrailCamJob[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Core hunting models
model HuntLog {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  date        DateTime
  zone        String?
  location    String?
  latitude    Float?
  longitude   Float?
  weather     String?
  wind        String?
  tempC       Float?
  moonPhase   String?
  weapon      String?
  sightings   Int      @default(0)
  harvested   Boolean  @default(false)
  notes       String?  @db.Text
  photos      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hunt_logs")
}

// ===== TRAIL CAM MASS DUMP + ACCURATE READER =====

model TrailCamJob {
  id            String   @id @default(cuid())
  userId        String
  name          String?  // e.g. "North Ridge SD card dump Oct 2026"
  status        String   @default("pending") // pending, uploading, analyzing, complete, failed
  totalFiles    Int      @default(0)
  processed     Int      @default(0)
  animalsFound  Int      @default(0)
  emptyFrames   Int      @default(0)
  deerCount     Int      @default(0)
  buckCount     Int      @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos TrailCamPhoto[]

  @@map("trail_cam_jobs")
}

model TrailCamPhoto {
  id              String   @id @default(cuid())
  userId          String
  jobId           String?
  title           String?
  imageUrl        String
  thumbnailUrl    String?
  originalName    String?

  // EXIF / camera metadata (extracted accurately)
  takenAt         DateTime?
  cameraMake      String?
  cameraModel     String?
  latitude        Float?
  longitude       Float?
  locationLabel   String?  // user or auto label e.g. "North Ridge Cam 3"

  // Detection results (MegaDetector-style accuracy goal)
  hasAnimal       Boolean  @default(false)
  hasPerson       Boolean  @default(false)
  hasVehicle      Boolean  @default(false)
  isEmpty         Boolean  @default(false)
  animalConfidence Float?  // 0-1
  species         String?  // "deer", "bear", "coyote", "unknown", etc.
  speciesConfidence Float?
  isDeer          Boolean  @default(false)
  isBuck          Boolean  @default(false)
  isDoe           Boolean  @default(false)
  antlerPoints    Int?     // estimated if buck
  detectionNotes  String?  // raw model notes or bounding boxes summary

  // User overrides (human always wins)
  userTags        String[]
  userNotes       String?  @db.Text
  isPublic        Boolean  @default(false)
  isFavorite      Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  TrailCamJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, takenAt])
  @@index([userId, isDeer])
  @@index([userId, isBuck])
  @@index([jobId])
  @@map("trail_cam_photos")
}

model Waypoint {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   // stand, cam, scrape, food, parking, etc.
  latitude    Float
  longitude   Float
  notes       String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("waypoints")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  isPrivate   Boolean  @default(true)
  createdAt   DateTime @default(now())

  members GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}
